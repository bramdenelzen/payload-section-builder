{
  "name": "payload-section-builder",
  "version": "0.1.1",
  "description": "Visual section builder for Payload CMS: select, edit and rearrange page sections from the live preview.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "psb-source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "psb-source": "./src/exports/client.ts",
      "import": "./dist/exports/client.js",
      "types": "./dist/exports/client.d.ts",
      "default": "./dist/exports/client.js"
    },
    "./overlay": {
      "psb-source": "./src/exports/overlay.ts",
      "import": "./dist/exports/overlay.js",
      "types": "./dist/exports/overlay.d.ts",
      "default": "./dist/exports/overlay.js"
    },
    "./react": {
      "psb-source": "./src/exports/react.ts",
      "import": "./dist/exports/react.js",
      "types": "./dist/exports/react.d.ts",
      "default": "./dist/exports/react.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm copyfiles && pnpm build:types && pnpm build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --outDir dist --rootDir ./src",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "dev": "next dev dev --turbo",
    "dev:generate-importmap": "pnpm dev:payload generate:importmap",
    "dev:generate-types": "pnpm dev:payload generate:types",
    "dev:payload": "cross-env NODE_OPTIONS=--conditions=psb-source PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "generate:importmap": "pnpm dev:generate-importmap",
    "generate:types": "pnpm dev:generate-types",
    "lint": "eslint",
    "lint:fix": "eslint ./src --fix",
    "prepare": "pnpm build",
    "test": "pnpm test:int && pnpm test:e2e",
    "test:e2e": "playwright test",
    "test:int": "vitest",
    "typecheck": "tsc --noEmit -p dev/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@payloadcms/db-sqlite": "3.93.0",
    "@payloadcms/eslint-config": "3.28.0",
    "@payloadcms/live-preview-react": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@playwright/test": "1.63.0",
    "@swc-node/register": "1.10.9",
    "@swc/cli": "0.6.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "copyfiles": "2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.23.0",
    "eslint-config-next": "16.3.3",
    "graphql": "^16.8.1",
    "next": "16.3.3",
    "open": "^10.1.0",
    "payload": "3.93.0",
    "prettier": "^3.4.2",
    "qs-esm": "8.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rimraf": "3.0.2",
    "sharp": "0.35.4",
    "sort-package-json": "^2.10.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "peerDependencies": {
    "payload": "^3.93.0",
    "@payloadcms/ui": "^3.93.0",
    "react": "^19.0.0"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "registry": "https://registry.npmjs.org/",
  "dependencies": {},
  "keywords": [
    "payload",
    "payload-plugin",
    "page-builder",
    "live-preview",
    "visual-editing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bramdenelzen/payload-section-builder.git"
  }
}
